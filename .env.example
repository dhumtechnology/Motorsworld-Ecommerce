APP_NAME=Motoworld
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Solo producción sin SSH: token para /cpanel-deploy.php?token=... (borrar el archivo tras usarlo)
# CPANEL_DEPLOY_TOKEN=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_PORT_EXTERNAL=3306
DB_CONNECTION=mysql
# Dentro de Docker siempre mysql:3306. No cambiar DB_PORT al usar DB_PORT_EXTERNAL.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=motoworld
DB_USERNAME=motoworld
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Consultas repetidas cacheadas en toda la app (segundos). 0 = desactivado.
QUERY_CACHE_TTL=300

# Docker seeders: auto (sistema si BD vacía) | true (siempre) | false (nunca)
# Sistema: roles, permisos, admin@motoworld.test, categorías y marcas. Demo en pausa.
SEED_ON_START=auto

# Docker assets (servicio node):
# SKIP_ASSET_BUILD=true → no corre Vite (útil si usas `npm run dev` en el host)
# ASSET_MODE=watch → public/build + recompila al guardar Blade (rápido; recomendado)
# ASSET_MODE=dev → Vite HMR :5173 (más lento en Docker Desktop)
# ASSET_MODE=once → una sola compilación
SKIP_ASSET_BUILD=false
ASSET_MODE=watch

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = solo escribe en storage/logs (local). smtp = envío real (cPanel/producción).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@motoworld.pe"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Culqi (legado — el checkout usa Mercado Pago)
CULQI_FAKE=true
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_ORDER_EXPIRATION_HOURS=24

# Mercado Pago (checkout actual)
# 1) Crea app en https://www.mercadopago.com.pe/developers
# 2) Copia Public Key + Access Token de prueba
# 3) Local: MERCADOPAGO_FAKE=true (sin llaves)
# 4) Test real: MERCADOPAGO_FAKE=false + llaves TEST-
# 5) Producción: llaves APP_USR- / producción
MERCADOPAGO_FAKE=true
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Decolecta — tipo de cambio SUNAT (USD/PEN)
# Se consulta a las 00:00 y 12:00 (America/Lima) vía `php artisan schedule:work`
DECOLECTA_API_TOKEN=
DECOLECTA_BASE_URL=https://api.decolecta.com/v1
DECOLECTA_REFERER=https://apis.net.pe/tipo-de-cambio-sunat-api
